{
  "name": "nexo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @nexo/backend build && pnpm --filter @nexo/frontend e2e"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
