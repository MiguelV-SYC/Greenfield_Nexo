# Copiar a `backend/.env` (no se commitea). Valores solo para desarrollo local.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Rol de la aplicación: sin BYPASSRLS (ADR-0001).
DATABASE_URL=postgresql://nexo_app:cambiar-app@localhost:5433/nexo
# Rol dueño del esquema: solo para `prisma migrate`.
DATABASE_URL_MIGRACIONES=postgresql://nexo_migrador:cambiar-migrador@localhost:5433/nexo
# Identidad simulada (D1, DEC-11): cabecera x-usuario-mock. Prohibido en producción.
AUTH_MODO=mock
# Documentos legales en MinIO (DEC-3). Credenciales del usuario nexo-app (infra/minio).
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_DOCUMENTOS=nexo-documentos
MINIO_ACCESS_KEY=nexo-app
MINIO_SECRET_KEY=cambiar-minio-app
URL_FIRMADA_TTL_SEGUNDOS=300
