# Copiar a `backend/.env` (no se commitea). Valores solo para desarrollo local.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Rol de la aplicación: sin BYPASSRLS (ADR-0001).
DATABASE_URL=postgresql://nexo_app:cambiar-app@localhost:5433/nexo
# Rol dueño del esquema: solo para `prisma migrate`.
DATABASE_URL_MIGRACIONES=postgresql://nexo_migrador:cambiar-migrador@localhost:5433/nexo
