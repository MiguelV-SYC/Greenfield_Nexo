{
  "name": "@nexo/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:unit": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integracion": "prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --selectProjects integracion",
    "generar": "prisma generate",
    "migrar": "prisma migrate deploy",
    "sembrar": "node dist/cli/sembrar-catalogos.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.2.1",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jest": "^30.5.2",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
