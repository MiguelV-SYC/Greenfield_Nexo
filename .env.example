# Copiar a `.env` (no se commitea) para `compose.yaml`.
# Valores solo para desarrollo local.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=cambiar-postgres
NEXO_MIGRADOR_PASSWORD=cambiar-migrador
NEXO_APP_PASSWORD=cambiar-app
# MinIO (DEC-3). root = administrador de infraestructura; la app usa su propio usuario.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nexo-root
MINIO_ROOT_PASSWORD=cambiar-minio-root
MINIO_APP_ACCESS_KEY=nexo-app
MINIO_APP_SECRET_KEY=cambiar-minio-app
